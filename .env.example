# Copia este archivo a .env si quieres cambiar algo. Todo es opcional.

# Puerto del panel (http://localhost:3737)
PORT=3737

# 127.0.0.1 = solo este PC. Pon 0.0.0.0 para abrir el panel desde el móvil/tablet en tu WiFi
HOST=127.0.0.1

# Carpeta de instalación del LoL (donde está el lockfile)
LOL_PATH=C:/Riot Games/League of Legends

# Región y rango de las estadísticas (OP.GG). Rangos: all, gold_plus, platinum_plus, emerald_plus, diamond_plus, master_plus
STATS_REGION=EUW
STATS_TIER=emerald_plus

# Idioma de nombres de campeones/objetos (Data Dragon)
LOCALE=es_ES

# Tiempos de los objetivos en minutos (temporada 2026). Cámbialos si Riot los modifica
BARON_FIRST_SPAWN_MIN=20
GRUBS_SPAWN_MIN=8
HERALD_SPAWN_MIN=15
HERALD_DESPAWN_MIN=19.75
INHIB_RESPAWN_MIN=5
